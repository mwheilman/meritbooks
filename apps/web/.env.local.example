# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (server-side only)
ANTHROPIC_API_KEY=

# Plaid (server-side only)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Transactional email (Resend). Both required for outbound email (invoices,
# statements, dunning, reminders, invitations, report packs) to actually send;
# when unset, those paths return an honest "email not configured" state.
RESEND_API_KEY=
INVOICE_FROM_EMAIL=

# Inbound AP email-to-bill webhook (/api/webhooks/inbound-email). Shared secret the
# email provider (SendGrid Inbound Parse / Postmark / Mailgun / Cloudflare) presents
# in `x-inbound-email-secret` or `Authorization: Bearer <secret>`. FAILS CLOSED when
# unset — the endpoint rejects every request.
INBOUND_EMAIL_SECRET=

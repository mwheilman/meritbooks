# Copy to .env (never commit it). EXPO_PUBLIC_* values are compiled into the app and are public by design:
# the Clerk PUBLISHABLE key (pk_...) is safe to ship; never put a Clerk SECRET key (sk_...) here.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
# Merit Projects (field work, clock, logs, photos, checklists, punch, crew time)
EXPO_PUBLIC_PROJECTS_API=https://your-merit-projects-app.vercel.app
# Merit Books (pay, commissions, receipts). Leave empty for a tenant without Merit Books.
EXPO_PUBLIC_BOOKS_API=https://meritbooks-web.vercel.app

# apps/projects — same Clerk instance + same Supabase project as Books (one DB).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Merit Books, for the ⌘J Products group and Books settings links.
NEXT_PUBLIC_BOOKS_URL=https://books.meritmgt.com
# Calendar "today" for due dates and the context line (default America/Chicago).
NEXT_PUBLIC_APP_TIME_ZONE=America/Chicago
# Not used by Merit Projects request paths (RLS client only); kept for shared tooling.
SUPABASE_SERVICE_ROLE_KEY=
# Only needed once the metered gateway call is wired:
ANTHROPIC_API_KEY=

{
  "name": "meritbooks",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "db:migrate": "cd packages/supabase && supabase db push",
    "db:seed": "cd packages/supabase && npx tsx seed/index.ts",
    "db:reset": "cd packages/supabase && supabase db reset",
    "db:types": "cd packages/supabase && supabase gen types typescript --local > types/database.ts"
  },
  "devDependencies": {
    "dotenv": "^17.4.1",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "npm@10.8.0",
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "@react-pdf/font": "4.0.9",
    "@react-pdf/pdfkit": "6.0.0",
    "@react-pdf/fns": "3.1.3",
    "@react-pdf/layout": "4.7.0",
    "@react-pdf/render": "4.6.0",
    "@react-pdf/primitives": "4.3.0",
    "@react-pdf/reconciler": "2.0.0",
    "@react-pdf/types": "2.11.2",
    "@react-pdf/textkit": "6.4.0",
    "@react-pdf/image": "3.1.1",
    "@react-pdf/svg": "1.1.0",
    "@react-pdf/stylesheet": "6.2.2"
  }
}
